##############################################
# GROZEO BIZAPI - Environment Configuration
# Copy to .env and fill in all values
##############################################

# --- Application ---
APP_NAME="Grozeo API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bizapi.yourdomain.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Session & Cache ---
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# --- Mail (Amazon SES / SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Grozeo"

# --- AWS General ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

# --- AWS DynamoDB ---
AWS_DYNAMODB_ACCESS_KEY_ID=
AWS_DYNAMODB_SECRET_ACCESS_KEY=
AWS_DYNAMODB_REGION=ap-south-1
AWSDYNAMODBTABLEPREFIX=

# --- AWS S3 Asset Upload ---
QUGEO_S3_UPLOAD_ACCESS=
QUGEO_S3_UPLOAD_SECRET=
QUGEO_S3_UPLOAD_BUCKET=
QUGEO_S3_UPLOAD_REGION=ap-southeast-1
QUGEO_DELIVERY_ASSET_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ASSET_BUCKET=
AWS_S3_ASSET_REGION=ap-southeast-1

# --- JWT ---
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Payment Gateways ---
# Razorpay
RP_API_KEY_ID=
RP_API_KEY=
RP_CNY=INR

# Stripe
STRIPE_KEY=
STRIPE_SECRET=

# Paytm
PAYTM_MERCHANT_KEY=
PAYTM_MERCHANT_ID=
PAYTM_CALLBACK_URL=

# Instamojo
IM_API_KEY=
IM_AUTH_TOKEN=
IM_URL=

# CCAvenue
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=

# Easebuzz
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# Easypay (Axis Bank)
EASYPAY_CID=
EASYPAY_TYP=
EASYPAY_VER=
EASYPAY_CNY=INR
EASYPAY_RE1=
EASYPAY_PAYMENT_URL=
EASYPAY_TOKEN_URL=
EASYPAY_ENQUIRY_URL=
EASYPAY_CHECKSUM_KEY=
EASYPAY_ENCRYPTION_KEY=

# Atom Payment Gateway
ATOM_LOGIN=
ATOM_PASS=
ATOM_TTYPE=
ATOM_TXNCURR=INR
ATOM_CLIENTCODE=
ATOM_CUSTACC=
ATOM_REQHASHKEY=
ATOM_RESPHASHKEY=
ATOM_AESREQHASHKEY=
ATOM_AESREQHASHKEYSALT=
ATOM_AESRESPHASHKEY=
ATOM_AESRESPHASHKEYSALT=
ATOM_PAYMENT_URL=
ATOM_TOKEN_URL=
ATOM_ENQUIRY_URL=
ATOM_CHECKSUM_KEY=
ATOM_ENCRYPTION_KEY=

# Revolut
REVOLUT_API_KEY=

# --- SMS Providers ---
SMS_API_KEY=
SMS_USERNAME=
TEXTLOCAL_API_KEY=
TEXT_LOCAL_SMS_PASSWORD=
KSMS_API_KEY=
KSMS_SENDER_ID=
BULKSMS_USERNAME=
BULKSMS_API_KEY=

# --- Google ---
GOOGLE_API_KEY=
GMAP_DIST_API_KEY=
IPINFO_TOKEN=

# --- Firebase ---
FCM_SERVER_KEY=

# --- Courier Partners ---
# Shipyaari
SHIPYAARI_CREATOR=
SHIPYAARI_AVNKEY=
SHIPYAARI_USERNAME=

# WorldOptions
WORLDOPTIONS_KEY=
WORLDOPTIONS_METERNUMBER=
WORLDOPTIONS_PASSWORD=

# --- Qugeo Tracking ---
QUGEO_TRACKING_API_GATEWAY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# --- Backoffice ---
BACKOFFICE_URL=

# --- Rate Limiting ---
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=5
RATE_LIMIT_OTP=3

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# --- Misc ---
REQUEST_HEADER=
FRONTEND_URL=https://yourdomain.com
ROUND_OFF=false
OPERATING_COUNTRY=UK
DEFAULT_CURRENCY_SYMBOL=£
