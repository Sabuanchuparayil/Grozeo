@{
    ViewData["Title"] = "Inventory";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Inventory</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Inventory</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Transfer" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-down-up me-1" aria-hidden="true"></i>Stock Transfer</a>
            <a asp-action="StockIn" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Stock Update</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Total SKUs</div>
                            <div class="stat-tile-value">0</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-upc-scan"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">In Stock</div>
                            <div class="stat-tile-value text-success">0</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-check2-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Low Stock</div>
                            <div class="stat-tile-value text-warning">0</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-exclamation-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Out of Stock</div>
                            <div class="stat-tile-value text-danger">0</div>
                        </div>
                        <div class="stat-tile-icon stat-danger" aria-hidden="true"><i class="bi bi-x-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">SKU</th>
                            <th scope="col">Product</th>
                            <th scope="col">Branch</th>
                            <th scope="col" class="text-center">Available</th>
                            <th scope="col" class="text-center">Reserved</th>
                            <th scope="col" class="text-center">Reorder Level</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7">
                                <div class="empty-state text-center py-5 px-3">
                                    <i class="bi bi-archive" aria-hidden="true"></i>
                                    <p class="text-muted mt-3 mb-3">Inventory tracking will appear here once products are configured.</p>
                                    <a asp-area="Tenant" asp-controller="Product" asp-action="Create" class="btn btn-primary btn-sm me-2"><i class="bi bi-box-seam me-1" aria-hidden="true"></i>Add products first</a>
                                    <a asp-action="StockIn" class="btn btn-outline-secondary btn-sm">Record stock in</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
