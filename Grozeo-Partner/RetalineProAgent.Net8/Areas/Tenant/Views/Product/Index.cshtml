@model List<RetalineProAgent.Models.ProductViewModel>
@{
    ViewData["Title"] = "Products";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var allProducts = RetalineProAgent.Services.MockDataService.GetProducts();
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Products</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="BulkUpload" class="btn btn-outline-secondary btn-sm"><i class="bi bi-upload me-1" aria-hidden="true"></i>Bulk Upload</a>
            <a asp-action="Pricing" class="btn btn-outline-secondary btn-sm"><i class="bi bi-tags me-1" aria-hidden="true"></i>Pricing</a>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Product</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Total Products</div>
                            <div class="stat-tile-value">@allProducts.Count</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Active</div>
                            <div class="stat-tile-value text-success">@allProducts.Count(p => p.Status == "Active")</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-check-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Out of Stock</div>
                            <div class="stat-tile-value text-danger">@allProducts.Count(p => p.Stock == 0)</div>
                        </div>
                        <div class="stat-tile-icon stat-danger" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Low Stock</div>
                            <div class="stat-tile-value text-warning">@allProducts.Count(p => p.Stock > 0 && p.Stock <= 5)</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-exclamation-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <span class="text-muted small me-2">Filter</span>
            <a asp-action="Index" class="badge rounded-pill @(currentStatus == "All" ? "bg-primary" : "bg-light text-muted border") text-decoration-none">All</a>
            <a asp-action="Index" asp-route-status="Active" class="badge rounded-pill @(currentStatus == "Active" ? "bg-primary" : "bg-light text-muted border") text-decoration-none">Active</a>
            <a asp-action="Index" asp-route-status="OutOfStock" class="badge rounded-pill @(currentStatus == "OutOfStock" ? "bg-primary" : "bg-light text-muted border") text-decoration-none">Out of Stock</a>
            <a asp-action="Index" asp-route-status="LowStock" class="badge rounded-pill @(currentStatus == "LowStock" ? "bg-primary" : "bg-light text-muted border") text-decoration-none">Low Stock</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">SKU</th>
                            <th scope="col">Name</th>
                            <th scope="col">Category</th>
                            <th scope="col" class="text-end">Price</th>
                            <th scope="col" class="text-center">Stock</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            var stockClass = product.Stock == 0 ? "text-danger" : product.Stock <= 5 ? "text-warning" : "text-success";
                            var statusClass = product.Status == "Active" ? "bg-success" : product.Status == "Low Stock" ? "bg-warning text-dark" : "bg-danger";
                            <tr>
                                <td><code>@product.SKU</code></td>
                                <td class="fw-medium">@product.Name</td>
                                <td><span class="badge bg-light text-dark border">@product.Category</span></td>
                                <td class="text-end">₹@product.Price.ToString("N2")</td>
                                <td class="text-center @stockClass fw-medium">@product.Stock</td>
                                <td><span class="badge @statusClass">@product.Status</span></td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this product?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
