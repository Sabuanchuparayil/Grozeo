@{
    ViewData["Title"] = "Store Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Store Settings</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active">Store Settings</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1"><i class="bi bi-shop me-2 text-primary"></i>Store Information</h5>
                            <p class="text-muted small mb-0">Basic store details, logo, and contact information</p>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" disabled>Edit</button>
                    </div>
                    <div class="border rounded p-3 bg-light">
                        <div class="row g-2 small">
                            <div class="col-4 text-muted">Store Name</div>
                            <div class="col-8">—</div>
                            <div class="col-4 text-muted">Email</div>
                            <div class="col-8">—</div>
                            <div class="col-4 text-muted">Phone</div>
                            <div class="col-8">—</div>
                            <div class="col-4 text-muted">Address</div>
                            <div class="col-8">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1"><i class="bi bi-clock me-2 text-primary"></i>Business Hours</h5>
                            <p class="text-muted small mb-0">Operating hours for each day of the week</p>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" disabled>Edit</button>
                    </div>
                    <div class="border rounded p-3 bg-light">
                        <div class="row g-2 small">
                            <div class="col-4 text-muted">Mon–Fri</div>
                            <div class="col-8">—</div>
                            <div class="col-4 text-muted">Saturday</div>
                            <div class="col-8">—</div>
                            <div class="col-4 text-muted">Sunday</div>
                            <div class="col-8">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1"><i class="bi bi-truck me-2 text-primary"></i>Delivery Settings</h5>
                            <p class="text-muted small mb-0">Delivery zones, charges, and minimum order values</p>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" disabled>Edit</button>
                    </div>
                    <div class="border rounded p-3 bg-light">
                        <div class="row g-2 small">
                            <div class="col-5 text-muted">Delivery Radius</div>
                            <div class="col-7">—</div>
                            <div class="col-5 text-muted">Delivery Charge</div>
                            <div class="col-7">—</div>
                            <div class="col-5 text-muted">Free Delivery Above</div>
                            <div class="col-7">—</div>
                            <div class="col-5 text-muted">Min Order Value</div>
                            <div class="col-7">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1"><i class="bi bi-credit-card me-2 text-primary"></i>Payment Methods</h5>
                            <p class="text-muted small mb-0">Accepted payment methods and gateway configuration</p>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" disabled>Edit</button>
                    </div>
                    <div class="border rounded p-3 bg-light">
                        <div class="row g-2 small">
                            <div class="col-5 text-muted">Cash on Delivery</div>
                            <div class="col-7"><span class="badge bg-secondary">Not configured</span></div>
                            <div class="col-5 text-muted">Online Payment</div>
                            <div class="col-7"><span class="badge bg-secondary">Not configured</span></div>
                            <div class="col-5 text-muted">UPI</div>
                            <div class="col-7"><span class="badge bg-secondary">Not configured</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
