@model RetalineProAgent.Models.DashboardStatsViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    var userName = ViewBag.UserName as string ?? "Partner";
    int totalUsers = ViewBag.TotalUsers ?? 5;
    int activeUsers = ViewBag.ActiveUsers ?? 4;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Welcome back, @userName</h2>
            <p class="text-muted mb-0">Here's what's happening with your store today.</p>
        </div>
        <div>
            <span class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 stat-tile" style="border-top: 4px solid #198754 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-tile-label mb-0">Revenue</p>
                            <p class="stat-tile-value mb-0">₹@Model.TotalRevenue.ToString("N0")</p>
                            <small class="text-success"><i class="bi bi-arrow-up"></i> 12% vs last week</small>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 stat-tile" style="border-top: 4px solid #0d6efd !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-tile-label mb-0">Orders</p>
                            <p class="stat-tile-value mb-0">@Model.TotalOrders</p>
                            <small class="text-muted">@Model.RecentOrders.Count(o => o.Status == "Processing") processing</small>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-cart3"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 stat-tile" style="border-top: 4px solid #fd7e14 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-tile-label mb-0">Products</p>
                            <p class="stat-tile-value mb-0">@Model.TotalProducts</p>
                            <small class="text-danger">@Model.LowStockProducts.Count low stock</small>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 stat-tile" style="border-top: 4px solid #6f42c1 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-tile-label mb-0">Customers</p>
                            <p class="stat-tile-value mb-0">@Model.TotalCustomers</p>
                            <small class="text-muted">@totalUsers team members</small>
                        </div>
                        <div class="stat-tile-icon" style="background:rgba(111,66,193,0.1);color:#6f42c1;" aria-hidden="true"><i class="bi bi-people"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Quick Actions</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-area="Tenant" asp-controller="Order" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-receipt me-1" aria-hidden="true"></i>Manage Orders
                        </a>
                        <a asp-area="Tenant" asp-controller="Product" asp-action="Create" class="btn btn-outline-success">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Product
                        </a>
                        <a asp-area="Finance" asp-controller="Settlement" asp-action="Index" class="btn btn-outline-warning">
                            <i class="bi bi-bank me-1" aria-hidden="true"></i>Settlements
                        </a>
                        <a asp-area="Support" asp-controller="Ticket" asp-action="Index" class="btn btn-outline-info">
                            <i class="bi bi-headset me-1" aria-hidden="true"></i>Support Tickets
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Orders</h5>
                    <a asp-area="Tenant" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th class="text-end">Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders.Take(5))
                                {
                                    var statusClass = order.Status switch
                                    {
                                        "Processing" => "bg-warning text-dark",
                                        "Shipped" => "bg-info",
                                        "Delivered" => "bg-success",
                                        "Cancelled" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td>
                                            <a asp-area="Tenant" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderNumber" class="fw-medium text-decoration-none">@order.OrderNumber</a>
                                            <br /><small class="text-muted">@order.OrderDate.ToString("dd MMM, hh:mm tt")</small>
                                        </td>
                                        <td>@order.CustomerName</td>
                                        <td class="text-end fw-medium">₹@order.Total.ToString("N2")</td>
                                        <td><span class="badge @statusClass">@order.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Low Stock Alert</h5>
                    <span class="badge bg-danger">@Model.LowStockProducts.Count items</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-medium">@p.Name</span>
                                    <br /><small class="text-muted">@p.SKU</small>
                                </div>
                                <span class="badge @(p.Stock == 0 ? "bg-danger" : "bg-warning text-dark")">@p.Stock left</span>
                            </li>
                        }
                        @if (!Model.LowStockProducts.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">All products are well stocked!</li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-area="Tenant" asp-controller="Product" asp-action="Index" asp-route-status="LowStock" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-arrow-right me-1"></i>Manage inventory
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">Pending Tasks</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (Model.PendingSettlements > 0)
                        {
                            <div class="col-md-4">
                                <div class="d-flex align-items-center p-3 bg-warning bg-opacity-10 rounded">
                                    <i class="bi bi-bank fs-3 text-warning me-3"></i>
                                    <div>
                                        <div class="fw-medium">Settlement Pending</div>
                                        <small class="text-muted">₹@Model.PendingSettlements.ToString("N2") awaiting</small>
                                    </div>
                                    <a asp-area="Finance" asp-controller="Settlement" asp-action="Index" class="btn btn-sm btn-warning ms-auto">View</a>
                                </div>
                            </div>
                        }
                        @if (Model.OpenTickets > 0)
                        {
                            <div class="col-md-4">
                                <div class="d-flex align-items-center p-3 bg-info bg-opacity-10 rounded">
                                    <i class="bi bi-headset fs-3 text-info me-3"></i>
                                    <div>
                                        <div class="fw-medium">Open Tickets</div>
                                        <small class="text-muted">@Model.OpenTickets tickets need attention</small>
                                    </div>
                                    <a asp-area="Support" asp-controller="Ticket" asp-action="Index" class="btn btn-sm btn-info ms-auto">View</a>
                                </div>
                            </div>
                        }
                        <div class="col-md-4">
                            <div class="d-flex align-items-center p-3 bg-success bg-opacity-10 rounded">
                                <i class="bi bi-check-circle fs-3 text-success me-3"></i>
                                <div>
                                    <div class="fw-medium">Store Active</div>
                                    <small class="text-muted">All systems operational</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
