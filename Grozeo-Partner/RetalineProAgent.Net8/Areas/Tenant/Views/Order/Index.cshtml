@model List<RetalineProAgent.Models.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var statusCounts = new Dictionary<string, int>
    {
        ["All"] = Model.Count,
        ["Processing"] = Model.Count(o => o.Status == "Processing"),
        ["Shipped"] = Model.Count(o => o.Status == "Shipped"),
        ["Delivered"] = Model.Count(o => o.Status == "Delivered"),
        ["Cancelled"] = Model.Count(o => o.Status == "Cancelled")
    };
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Orders</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Orders</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Returns" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>Returns</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Total Orders</div>
                            <div class="stat-tile-value">@Model.Count</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-receipt"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Processing</div>
                            <div class="stat-tile-value text-warning">@statusCounts["Processing"]</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Shipped</div>
                            <div class="stat-tile-value text-info">@statusCounts["Shipped"]</div>
                        </div>
                        <div class="stat-tile-icon stat-info" aria-hidden="true"><i class="bi bi-truck"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Delivered</div>
                            <div class="stat-tile-value text-success">@statusCounts["Delivered"]</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-check-circle"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <span class="text-muted small me-2">Filter by status</span>
            @foreach (var status in new[] { "All", "Processing", "Shipped", "Delivered", "Cancelled" })
            {
                <a asp-action="Index" asp-route-status="@status" 
                   class="badge rounded-pill @(currentStatus == status ? "bg-primary" : "bg-light text-muted border") text-decoration-none">
                    @status <span class="@(currentStatus == status ? "" : "text-dark")">@statusCounts.GetValueOrDefault(status, 0)</span>
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Order #</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col">Payment</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var order in Model)
                            {
                                var statusClass = order.Status switch
                                {
                                    "Processing" => "bg-warning text-dark",
                                    "Shipped" => "bg-info",
                                    "Delivered" => "bg-success",
                                    "Cancelled" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@order.OrderNumber" class="fw-medium text-decoration-none">@order.OrderNumber</a></td>
                                    <td>
                                        <div>@order.CustomerName</div>
                                        <small class="text-muted">@order.CustomerEmail</small>
                                    </td>
                                    <td>
                                        <div>@order.OrderDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-end fw-medium">₹@order.Total.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@order.PaymentMethod</span></td>
                                    <td><span class="badge @statusClass">@order.Status</span></td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@order.OrderNumber" class="btn btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                            @if (order.Status == "Processing")
                                            {
                                                <button type="button" class="btn btn-outline-secondary" title="Print" onclick="window.print()"><i class="bi bi-printer"></i></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state text-center py-5 px-3">
                                        <i class="bi bi-receipt" aria-hidden="true"></i>
                                        <p class="text-muted mt-3 mb-3">No orders found matching your filter.</p>
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear filters</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
