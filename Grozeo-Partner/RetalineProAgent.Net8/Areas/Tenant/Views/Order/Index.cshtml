@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Orders</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active">Orders</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-secondary btn-sm" disabled><i class="bi bi-download me-1"></i>Export</button>
            <button class="btn btn-primary btn-sm" disabled><i class="bi bi-plus-lg me-1"></i>New Order</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body pb-0">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item"><a class="nav-link active" href="#">All</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Active <span class="badge bg-primary ms-1">0</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#">Completed <span class="badge bg-success ms-1">0</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#">Cancelled <span class="badge bg-danger ms-1">0</span></a></li>
            </ul>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th class="text-end">Total</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">
                                <div class="text-center py-5">
                                    <i class="bi bi-receipt display-4 text-muted"></i>
                                    <p class="text-muted mt-3 mb-0">No orders found. Orders will appear here when customers place them.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
