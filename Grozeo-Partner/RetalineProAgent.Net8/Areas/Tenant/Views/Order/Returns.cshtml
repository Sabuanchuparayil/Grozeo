@{
    ViewData["Title"] = "Returns & Refunds";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Returns & Refunds</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Returns</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Pending Returns</div>
                            <div class="stat-tile-value text-warning">3</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-arrow-return-left"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Refunds Processed</div>
                            <div class="stat-tile-value text-success">₹4,250</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-cash-stack"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">This Month</div>
                            <div class="stat-tile-value text-primary">12</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-calendar-month"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Return #</th>
                            <th scope="col">Order #</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Reason</th>
                            <th scope="col" class="text-end">Refund Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-medium">RTN-0023</td>
                            <td><a asp-action="Details" asp-route-id="GRZ-2026-0003">GRZ-2026-0003</a></td>
                            <td>Amit Kumar</td>
                            <td>Product damaged</td>
                            <td class="text-end">₹450.00</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-success" title="Approve"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-outline-danger" title="Reject"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-medium">RTN-0022</td>
                            <td><a asp-action="Details" asp-route-id="GRZ-2026-0004">GRZ-2026-0004</a></td>
                            <td>Sneha Reddy</td>
                            <td>Wrong item received</td>
                            <td class="text-end">₹675.00</td>
                            <td><span class="badge bg-info">Processing</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-medium">RTN-0021</td>
                            <td><a asp-action="Details" asp-route-id="GRZ-2026-0002">GRZ-2026-0002</a></td>
                            <td>Priya Patel</td>
                            <td>Changed mind</td>
                            <td class="text-end">₹899.50</td>
                            <td><span class="badge bg-success">Refunded</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
