@{
    ViewData["Title"] = "Delivery";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Delivery</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Delivery</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Slots" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clock me-1" aria-hidden="true"></i>Manage Slots</a>
            <a asp-action="JobConfirm" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Assign Delivery</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <span class="text-muted small me-2">Filters <span class="badge bg-light text-secondary border">preview</span></span>
            <span class="badge rounded-pill bg-primary">Active 0</span>
            <span class="badge rounded-pill bg-light text-muted border">Scheduled <span class="text-info">0</span></span>
            <span class="badge rounded-pill bg-light text-muted border">Completed <span class="text-success">0</span></span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Delivery #</th>
                            <th scope="col">Order</th>
                            <th scope="col">Driver</th>
                            <th scope="col">Status</th>
                            <th scope="col">ETA</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">
                                <div class="empty-state text-center py-5 px-3">
                                    <i class="bi bi-truck" aria-hidden="true"></i>
                                    <p class="text-muted mt-3 mb-3">No active deliveries. Deliveries will appear here when orders are dispatched.</p>
                                    <a asp-action="Slots" class="btn btn-primary btn-sm me-2"><i class="bi bi-clock me-1" aria-hidden="true"></i>Set up delivery slots</a>
                                    <a asp-area="Tenant" asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary btn-sm">Go to orders</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
