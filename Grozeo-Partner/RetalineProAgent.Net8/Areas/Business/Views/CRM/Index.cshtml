@model List<RetalineProAgent.Models.CustomerViewModel>
@{
    ViewData["Title"] = "CRM";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Customer Relationship Management</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">CRM</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Leads" class="btn btn-outline-secondary btn-sm"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Leads</a>
            <a asp-action="Contacts" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Customer</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Total Customers</div>
                            <div class="stat-tile-value text-primary">@Model.Count</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-people"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">VIP Customers</div>
                            <div class="stat-tile-value text-success">@Model.Count(c => c.Status == "VIP")</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-trophy"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">New This Month</div>
                            <div class="stat-tile-value text-info">@Model.Count(c => c.Status == "New")</div>
                        </div>
                        <div class="stat-tile-icon stat-info" aria-hidden="true"><i class="bi bi-star"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Total Revenue</div>
                            <div class="stat-tile-value text-warning">₹@Model.Sum(c => c.TotalSpent).ToString("N0")</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Customer</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Orders</th>
                            <th scope="col" class="text-end">Total Spent</th>
                            <th scope="col">Joined</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            var statusClass = customer.Status switch
                            {
                                "VIP" => "bg-success",
                                "Active" => "bg-primary",
                                "New" => "bg-info",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td class="fw-medium">@customer.Name</td>
                                <td>
                                    <div>@customer.Email</div>
                                    <small class="text-muted">@customer.Phone</small>
                                </td>
                                <td><span class="badge @statusClass">@customer.Status</span></td>
                                <td class="text-center">@customer.TotalOrders</td>
                                <td class="text-end fw-medium">₹@customer.TotalSpent.ToString("N0")</td>
                                <td>@customer.JoinedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="View" onclick="alert('Customer details for @customer.Name')"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-outline-secondary" title="Email" onclick="alert('Email sent to @customer.Email')"><i class="bi bi-envelope"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
