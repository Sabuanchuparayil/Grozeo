@model List<RetalineProAgent.Models.LeadViewModel>
@{
    ViewData["Title"] = "Follow-ups";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Follow-ups Required</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">CRM</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Follow-ups</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Lead</th>
                            <th scope="col">Status</th>
                            <th scope="col">Assigned To</th>
                            <th scope="col">Last Contact</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@lead.Name</div>
                                    <small class="text-muted">@lead.Email</small>
                                </td>
                                <td><span class="badge @(lead.Status == "Contacted" ? "bg-info" : "bg-warning text-dark")">@lead.Status</span></td>
                                <td>@lead.AssignedTo</td>
                                <td>@lead.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-success" onclick="alert('Follow-up logged for @lead.Name')">
                                        <i class="bi bi-check-lg me-1"></i>Log Follow-up
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No follow-ups pending.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
