@model List<RetalineProAgent.Models.LeadViewModel>
@{
    ViewData["Title"] = "Leads";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Leads Pipeline</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">CRM</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leads</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-primary btn-sm" onclick="alert('Add Lead form would open here')"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Lead</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">New Leads</div>
                            <div class="stat-tile-value text-primary">@Model.Count(l => l.Status == "New")</div>
                        </div>
                        <div class="stat-tile-icon stat-primary" aria-hidden="true"><i class="bi bi-star"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Contacted</div>
                            <div class="stat-tile-value text-info">@Model.Count(l => l.Status == "Contacted")</div>
                        </div>
                        <div class="stat-tile-icon stat-info" aria-hidden="true"><i class="bi bi-telephone"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Qualified</div>
                            <div class="stat-tile-value text-warning">@Model.Count(l => l.Status == "Qualified" || l.Status == "Proposal")</div>
                        </div>
                        <div class="stat-tile-icon stat-warning" aria-hidden="true"><i class="bi bi-patch-check"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Won</div>
                            <div class="stat-tile-value text-success">@Model.Count(l => l.Status == "Won")</div>
                        </div>
                        <div class="stat-tile-icon stat-success" aria-hidden="true"><i class="bi bi-trophy"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Lead</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Source</th>
                            <th scope="col">Status</th>
                            <th scope="col">Assigned To</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model)
                        {
                            var statusClass = lead.Status switch
                            {
                                "New" => "bg-primary",
                                "Contacted" => "bg-info",
                                "Qualified" => "bg-warning text-dark",
                                "Proposal" => "bg-secondary",
                                "Won" => "bg-success",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td class="fw-medium">@lead.Name</td>
                                <td>
                                    <div>@lead.Email</div>
                                    <small class="text-muted">@lead.Phone</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@lead.Source</span></td>
                                <td><span class="badge @statusClass">@lead.Status</span></td>
                                <td>@lead.AssignedTo</td>
                                <td>@lead.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="View" onclick="alert('Lead details for @lead.Name')"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-outline-success" title="Convert" onclick="alert('Convert @lead.Name to customer')"><i class="bi bi-arrow-right-circle"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
