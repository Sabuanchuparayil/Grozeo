@model List<RetalineProAgent.Models.CustomerViewModel>
@{
    ViewData["Title"] = "Top Retailers";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Top Retailers</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">CRM</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Top Retailers</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Retailer</th>
                            <th>Contact</th>
                            <th class="text-center">Orders</th>
                            <th class="text-end">Total Spent</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.OrderByDescending(x => x.TotalSpent))
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@c.Name</span>
                                    @if (c.Status == "VIP")
                                    {
                                        <span class="badge bg-success ms-1">VIP</span>
                                    }
                                </td>
                                <td>@c.Email</td>
                                <td class="text-center">@c.TotalOrders</td>
                                <td class="text-end fw-medium">₹@c.TotalSpent.ToString("N0")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" onclick="alert('View @c.Name')"><i class="bi bi-eye"></i></button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No top retailers yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
