@model List<RetalineProAgent.Models.CustomerViewModel>
@{
    ViewData["Title"] = "Contacts";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">All Contacts</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">CRM</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Contacts</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-secondary btn-sm" onclick="alert('Export contacts')"><i class="bi bi-download me-1"></i>Export</button>
            <button class="btn btn-primary btn-sm" onclick="alert('Add contact form')"><i class="bi bi-plus-lg me-1"></i>Add Contact</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Status</th>
                            <th scope="col">Orders</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-medium">@c.Name</td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td><span class="badge @(c.Status == "VIP" ? "bg-success" : c.Status == "New" ? "bg-info" : "bg-primary")">@c.Status</span></td>
                                <td>@c.TotalOrders</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" onclick="alert('Edit @c.Name')"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
