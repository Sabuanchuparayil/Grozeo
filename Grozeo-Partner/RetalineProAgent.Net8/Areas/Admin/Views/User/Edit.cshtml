@model RetalineProAgent.Models.AppUser
@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3" aria-label="Back to users">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
                <h2 class="mb-0">Edit User <small class="text-muted">#@Model.usr_id</small></h2>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editUserForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="usr_id" value="@Model.usr_id" />
                        <input type="hidden" id="initialStatus" value="@Model.usr_status" />

                        <div class="mb-3">
                            <label for="usr_name" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="usr_name" name="usr_name" required
                                   value="@Model.usr_name" placeholder="Enter full name" autocomplete="name" />
                            <div class="invalid-feedback">Full name is required.</div>
                        </div>

                        <div class="mb-3">
                            <label for="usr_email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="usr_email" name="usr_email" required
                                   value="@Model.usr_email" placeholder="Enter email address" autocomplete="email" />
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label">New Password</label>
                                <input type="password" class="form-control" id="password" name="password"
                                       minlength="6" placeholder="Leave blank to keep current" autocomplete="new-password" />
                                <div class="invalid-feedback">Password must be at least 6 characters.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="confirmPassword" class="form-label">Confirm New Password</label>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                                       minlength="6" placeholder="Re-enter new password" autocomplete="new-password" />
                                <div class="invalid-feedback" id="confirmPasswordFeedback">Passwords do not match.</div>
                            </div>
                        </div>
                        <p class="text-muted small mt-n2 mb-3">Only fill password fields if you want to change the password.</p>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="usr_role" class="form-label">Role <span class="text-danger">*</span></label>
                                <select class="form-select" id="usr_role" name="usr_role" required>
                                    <option value="SuperAdmin" @(Model.usr_role == "SuperAdmin" ? "selected" : "")>SuperAdmin</option>
                                    <option value="TenantAdmin" @(Model.usr_role == "TenantAdmin" ? "selected" : "")>TenantAdmin</option>
                                    <option value="Finance" @(Model.usr_role == "Finance" ? "selected" : "")>Finance</option>
                                    <option value="Support" @(Model.usr_role == "Support" ? "selected" : "")>Support</option>
                                </select>
                                <div class="invalid-feedback">Please select a role.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="usr_branch_id" class="form-label">Branch ID</label>
                                <input type="number" class="form-control" id="usr_branch_id" name="usr_branch_id"
                                       value="@Model.usr_branch_id" min="0" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="statusCheck"
                                       @(Model.usr_status == 1 ? "checked" : "")
                                       onchange="document.getElementById('usr_status').value = this.checked ? 1 : 0" />
                                <label class="form-check-label" for="statusCheck">Active</label>
                                <input type="hidden" id="usr_status" name="usr_status" value="@Model.usr_status" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('editUserForm');
        var pw = document.getElementById('password');
        var cpw = document.getElementById('confirmPassword');
        var cpwFeedback = document.getElementById('confirmPasswordFeedback');
        var initialStatus = parseInt(document.getElementById('initialStatus').value, 10);
        var statusCheck = document.getElementById('statusCheck');

        function clearFieldInvalid(field) {
            field.classList.remove('is-invalid');
        }

        form.querySelectorAll('input, select').forEach(function (el) {
            el.addEventListener('input', function () { clearFieldInvalid(el); });
            el.addEventListener('change', function () { clearFieldInvalid(el); });
        });

        form.addEventListener('submit', function (e) {
            form.querySelectorAll('.is-invalid').forEach(function (el) {
                el.classList.remove('is-invalid');
            });

            var isValid = true;
            var firstInvalid = null;

            form.querySelectorAll('[required]').forEach(function (field) {
                if (!field.checkValidity()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = field;
                }
            });

            if (pw.value) {
                if (pw.value.length < 6) {
                    pw.classList.add('is-invalid');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = pw;
                }
                if (cpw.value.length < 6) {
                    cpwFeedback.textContent = 'Password must be at least 6 characters.';
                    cpw.classList.add('is-invalid');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = cpw;
                } else if (pw.value !== cpw.value) {
                    cpwFeedback.textContent = 'Passwords do not match.';
                    pw.classList.add('is-invalid');
                    cpw.classList.add('is-invalid');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = cpw;
                }
            }

            if (!isValid) {
                e.preventDefault();
                e.stopPropagation();
                if (firstInvalid) firstInvalid.focus();
                return;
            }

            if (initialStatus === 1 && !statusCheck.checked) {
                if (!window.confirm('Deactivate this user? They will no longer be able to sign in.')) {
                    e.preventDefault();
                }
            }
        });
    })();
</script>
}
