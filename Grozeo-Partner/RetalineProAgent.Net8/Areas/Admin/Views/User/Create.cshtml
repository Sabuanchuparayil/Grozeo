@{
    ViewData["Title"] = "Create User";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3" aria-label="Back to users">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
                <h2 class="mb-0">Create User</h2>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createUserForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="usr_name" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="usr_name" name="usr_name" required
                                   placeholder="Enter full name" autocomplete="name" />
                            <div class="invalid-feedback">Full name is required.</div>
                        </div>

                        <div class="mb-3">
                            <label for="usr_email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="usr_email" name="usr_email" required
                                   placeholder="Enter email address" autocomplete="email" />
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="password" name="password" required
                                       minlength="6" placeholder="Minimum 6 characters" autocomplete="new-password" />
                                <div class="invalid-feedback">Password must be at least 6 characters.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required
                                       minlength="6" placeholder="Re-enter password" autocomplete="new-password" />
                                <div class="invalid-feedback" id="confirmPasswordFeedback">Please confirm your password.</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="usr_role" class="form-label">Role <span class="text-danger">*</span></label>
                                <select class="form-select" id="usr_role" name="usr_role" required>
                                    <option value="">Select a role</option>
                                    <option value="SuperAdmin">SuperAdmin</option>
                                    <option value="TenantAdmin">TenantAdmin</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Support">Support</option>
                                </select>
                                <div class="invalid-feedback">Please select a role.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="usr_branch_id" class="form-label">Branch ID</label>
                                <input type="number" class="form-control" id="usr_branch_id" name="usr_branch_id"
                                       value="0" min="0" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="statusCheck" checked
                                       onchange="document.getElementById('usr_status').value = this.checked ? 1 : 0" />
                                <label class="form-check-label" for="statusCheck">Active</label>
                                <input type="hidden" id="usr_status" name="usr_status" value="1" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Create User
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('createUserForm');
        var pw = document.getElementById('password');
        var cpw = document.getElementById('confirmPassword');
        var cpwFeedback = document.getElementById('confirmPasswordFeedback');

        function clearFieldInvalid(field) {
            field.classList.remove('is-invalid');
        }

        form.querySelectorAll('input, select').forEach(function (el) {
            el.addEventListener('input', function () { clearFieldInvalid(el); });
            el.addEventListener('change', function () { clearFieldInvalid(el); });
        });

        form.addEventListener('submit', function (e) {
            form.querySelectorAll('.is-invalid').forEach(function (el) {
                el.classList.remove('is-invalid');
            });

            var isValid = true;
            var firstInvalid = null;

            form.querySelectorAll('[required], [minlength]').forEach(function (field) {
                if (field.id === 'confirmPassword') return;
                var valid = field.checkValidity();
                if (!valid) {
                    field.classList.add('is-invalid');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = field;
                }
            });

            if (!cpw.value) {
                cpwFeedback.textContent = 'Please confirm your password.';
                cpw.classList.add('is-invalid');
                isValid = false;
                if (!firstInvalid) firstInvalid = cpw;
            } else if (cpw.value.length < 6) {
                cpwFeedback.textContent = 'Password must be at least 6 characters.';
                cpw.classList.add('is-invalid');
                isValid = false;
                if (!firstInvalid) firstInvalid = cpw;
            } else if (pw.value !== cpw.value) {
                cpwFeedback.textContent = 'Passwords do not match.';
                pw.classList.add('is-invalid');
                cpw.classList.add('is-invalid');
                isValid = false;
                if (!firstInvalid) firstInvalid = cpw;
            }

            if (!isValid) {
                e.preventDefault();
                e.stopPropagation();
                if (firstInvalid) firstInvalid.focus();
            }
        });
    })();
</script>
}
