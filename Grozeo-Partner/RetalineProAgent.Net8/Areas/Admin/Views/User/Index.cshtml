@model IEnumerable<RetalineProAgent.Models.AppUser>
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
    var q = ViewBag.SearchQuery as string;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
        <div>
            <h4 class="mb-1 fw-bold">Users</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Users</li>
                </ol>
            </nav>
            <a asp-action="Roles" class="small text-decoration-none">Role descriptions</a>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form method="get" asp-action="Index" class="d-flex gap-2" role="search">
                <label for="userSearch" class="visually-hidden">Search users</label>
                <input type="search" id="userSearch" name="q" value="@q" class="form-control form-control-sm"
                       placeholder="Search name or email…" style="min-width:200px;" autocomplete="off" />
                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden"> Search</span></button>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add User
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                var roleBadge = user.usr_role switch
                                {
                                    "SuperAdmin" => "danger",
                                    "TenantAdmin" => "primary",
                                    "Finance" => "warning",
                                    "Support" => "info",
                                    _ => "secondary"
                                };

                                <tr>
                                    <td><strong>@user.usr_id</strong></td>
                                    <td>@user.usr_name</td>
                                    <td>@user.usr_email</td>
                                    <td><span class="badge bg-@roleBadge">@user.usr_role</span></td>
                                    <td>
                                        @if (user.usr_status == 1)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Inactive</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(user.usr_created_at.HasValue ? user.usr_created_at.Value.ToString("dd MMM yyyy") : "N/A")
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@user.usr_id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state py-2">
                                        <i class="bi bi-people" aria-hidden="true"></i>
                                        <h3 class="h5 mt-2">No users found</h3>
                                        <p class="text-muted mb-3">@(string.IsNullOrWhiteSpace(q) ? "Add your first administrator or staff member." : "Try a different search term.")</p>
                                        @if (!string.IsNullOrWhiteSpace(q))
                                        {
                                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">Clear search</a>
                                        }
                                        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add user</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        e.preventDefault();
        var el = document.getElementById('userSearch');
        if (el) el.focus();
    });
</script>
}
