@{
    ViewData["Title"] = "Role Management";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3" aria-label="Back to users">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <h2 class="mb-0">Role Management</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #dc3545 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-danger me-2 fs-6">SuperAdmin</span>
                    </div>
                    <p class="text-muted mb-3">Full system access with unrestricted permissions across all areas.</p>
                    <h6 class="fw-semibold mb-2">Permissions:</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>User management</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>System configuration</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>All tenant operations</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Financial reports &amp; settlements</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Support ticket management</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #0d6efd !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-primary me-2 fs-6">TenantAdmin</span>
                    </div>
                    <p class="text-muted mb-3">Store-level administration for managing daily operations and inventory.</p>
                    <h6 class="fw-semibold mb-2">Permissions:</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Dashboard access</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Order management</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Product &amp; inventory management</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Store settings</li>
                        <li><i class="bi bi-x-circle-fill text-danger me-1" aria-hidden="true"></i><span class="text-muted">No user management</span></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #ffc107 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-warning text-dark me-2 fs-6">Finance</span>
                    </div>
                    <p class="text-muted mb-3">Access to financial data, settlements, invoices, and payment reports.</p>
                    <h6 class="fw-semibold mb-2">Permissions:</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Settlement reports</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Invoice management</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Payment history</li>
                        <li class="mb-1"><i class="bi bi-x-circle-fill text-danger me-1" aria-hidden="true"></i><span class="text-muted">No order management</span></li>
                        <li><i class="bi bi-x-circle-fill text-danger me-1" aria-hidden="true"></i><span class="text-muted">No product management</span></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #0dcaf0 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-info me-2 fs-6">Support</span>
                    </div>
                    <p class="text-muted mb-3">Customer support access for handling tickets, queries, and escalations.</p>
                    <h6 class="fw-semibold mb-2">Permissions:</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Support ticket management</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>View order details (read-only)</li>
                        <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Customer communication</li>
                        <li class="mb-1"><i class="bi bi-x-circle-fill text-danger me-1" aria-hidden="true"></i><span class="text-muted">No financial access</span></li>
                        <li><i class="bi bi-x-circle-fill text-danger me-1" aria-hidden="true"></i><span class="text-muted">No system configuration</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
