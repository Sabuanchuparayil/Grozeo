@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">System Settings</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">System</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-primary flex-shrink-0" aria-hidden="true"><i class="bi bi-gear"></i></div>
                        <div>
                            <h6 class="card-title mb-0">General Settings</h6>
                            <small class="text-muted">App name, timezone, locale</small>
                        </div>
                    </div>
                    <p class="text-muted small">Configure application-wide settings including branding, timezone, default currency, and language preferences.</p>
                    <a asp-action="Settings" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-success flex-shrink-0" aria-hidden="true"><i class="bi bi-envelope"></i></div>
                        <div>
                            <h6 class="card-title mb-0">Email Configuration</h6>
                            <small class="text-muted">SMTP, templates, notifications</small>
                        </div>
                    </div>
                    <p class="text-muted small">Set up SMTP credentials, customise email templates, and manage transactional email preferences.</p>
                    <a asp-action="Jobs" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-warning flex-shrink-0" aria-hidden="true"><i class="bi bi-credit-card-2-back"></i></div>
                        <div>
                            <h6 class="card-title mb-0">Payment Gateway</h6>
                            <small class="text-muted">Razorpay, Stripe, PayU</small>
                        </div>
                    </div>
                    <p class="text-muted small">Connect and configure payment gateway credentials, webhooks, and supported payment methods.</p>
                    <a asp-action="Settings" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-info flex-shrink-0" aria-hidden="true"><i class="bi bi-chat-dots"></i></div>
                        <div>
                            <h6 class="card-title mb-0">SMS Configuration</h6>
                            <small class="text-muted">Twilio, MSG91, provider setup</small>
                        </div>
                    </div>
                    <p class="text-muted small">Configure SMS gateway credentials, sender ID, templates, and OTP delivery settings.</p>
                    <a asp-action="Settings" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-danger flex-shrink-0" aria-hidden="true"><i class="bi bi-key"></i></div>
                        <div>
                            <h6 class="card-title mb-0">API Keys</h6>
                            <small class="text-muted">Tokens, secrets, integrations</small>
                        </div>
                    </div>
                    <p class="text-muted small">Manage API keys for third-party integrations, webhook secrets, and service-to-service authentication.</p>
                    <a asp-action="Settings" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3 gap-3">
                        <div class="stat-tile-icon stat-secondary flex-shrink-0" aria-hidden="true"><i class="bi bi-journal-code"></i></div>
                        <div>
                            <h6 class="card-title mb-0">Logs &amp; Jobs</h6>
                            <small class="text-muted">Background tasks, audit trail</small>
                        </div>
                    </div>
                    <p class="text-muted small">View application logs, background job status, scheduled tasks, and system audit trail.</p>
                    <a asp-action="Logs" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Configure</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body empty-state text-center py-5">
            <i class="bi bi-sliders" aria-hidden="true"></i>
            <p class="text-muted mt-3 mb-3">Jump into logs or background jobs when you need deeper diagnostics.</p>
            <a asp-action="Logs" class="btn btn-outline-secondary btn-sm me-2">Open logs</a>
            <a asp-action="Jobs" class="btn btn-outline-secondary btn-sm">Background jobs</a>
        </div>
    </div>
</div>
