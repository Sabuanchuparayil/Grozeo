@{
    ViewData["Title"] = "Support Tickets";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Support Tickets</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active">Support Tickets</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-primary btn-sm" disabled><i class="bi bi-plus-lg me-1"></i>New Ticket</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4">
                <div class="card-body text-center">
                    <div class="text-muted small">Open</div>
                    <div class="fs-4 fw-bold text-danger">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4">
                <div class="card-body text-center">
                    <div class="text-muted small">In Progress</div>
                    <div class="fs-4 fw-bold text-warning">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm border-start border-success border-4">
                <div class="card-body text-center">
                    <div class="text-muted small">Resolved</div>
                    <div class="fs-4 fw-bold text-success">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm border-start border-secondary border-4">
                <div class="card-body text-center">
                    <div class="text-muted small">Total</div>
                    <div class="fs-4 fw-bold">0</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket #</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Assigned To</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7">
                                <div class="text-center py-5">
                                    <i class="bi bi-headset display-4 text-muted"></i>
                                    <p class="text-muted mt-3 mb-0">No support tickets found. Create a ticket to get help from the support team.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
