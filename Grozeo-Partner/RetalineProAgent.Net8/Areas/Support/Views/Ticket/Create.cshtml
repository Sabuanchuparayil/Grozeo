@model RetalineProAgent.Models.TicketViewModel
@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3" aria-label="Back">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
                <h2 class="mb-0">Create Support Ticket</h2>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="Subject" class="form-label">Subject <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Subject" name="Subject" required placeholder="Brief description of the issue" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Priority" class="form-label">Priority <span class="text-danger">*</span></label>
                                <select class="form-select" id="Priority" name="Priority" required>
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="CustomerName" class="form-label">Customer Name</label>
                                <input type="text" class="form-control" id="CustomerName" name="CustomerName" placeholder="Optional" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="Description" name="Description" rows="5" required placeholder="Detailed description of the issue..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1" aria-hidden="true"></i>Submit Ticket
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
