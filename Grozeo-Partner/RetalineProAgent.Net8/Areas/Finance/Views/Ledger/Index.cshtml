@{
    ViewData["Title"] = "Ledger";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Ledger</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Ledger</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0 align-items-center">
            <select class="form-select form-select-sm" style="max-width:200px;" disabled title="Coming soon">
                <option selected>All Accounts</option>
            </select>
            <div class="input-group input-group-sm" style="max-width:280px;">
                <input type="date" class="form-control" disabled title="Coming soon" />
                <span class="input-group-text">to</span>
                <input type="date" class="form-control" disabled title="Coming soon" />
            </div>
            <a asp-action="Groups" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Description</th>
                            <th scope="col">Reference</th>
                            <th scope="col" class="text-end">Debit</th>
                            <th scope="col" class="text-end">Credit</th>
                            <th scope="col" class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">
                                <div class="empty-state text-center py-5 px-3">
                                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                                    <p class="text-muted mt-3 mb-3">No ledger entries found. Transactions will appear here as they are recorded.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm me-2"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New ledger entry</a>
                                    <a asp-action="Groups" class="btn btn-outline-secondary btn-sm">Manage groups</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">Totals</td>
                            <td class="text-end">&#8377;0.00</td>
                            <td class="text-end">&#8377;0.00</td>
                            <td class="text-end">&#8377;0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
