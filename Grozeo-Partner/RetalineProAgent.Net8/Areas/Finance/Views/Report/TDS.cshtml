@{
    ViewData["Title"] = "TDS Report";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">TDS Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Report</a></li>
                    <li class="breadcrumb-item active" aria-current="page">TDS Report</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-minus display-4 text-primary opacity-50"></i>
            <h5 class="mt-3 mb-2">TDS Report</h5>
            <p class="text-muted mb-0">View TDS deductions and certificates.</p>
        </div>
    </div>
</div>
