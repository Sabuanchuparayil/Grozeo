@{
    ViewData["Title"] = "Vouchers";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Vouchers</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Vouchers</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Details" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</a>
            <a asp-action="Entry" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create Voucher</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <span class="text-muted small me-2">Types <span class="badge bg-light text-secondary border">preview</span></span>
            <span class="badge rounded-pill bg-primary">All</span>
            <span class="badge rounded-pill bg-light text-muted border">Payment</span>
            <span class="badge rounded-pill bg-light text-muted border">Receipt</span>
            <span class="badge rounded-pill bg-light text-muted border">Journal</span>
            <span class="badge rounded-pill bg-light text-muted border">Contra</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Voucher #</th>
                            <th scope="col">Type</th>
                            <th scope="col">Date</th>
                            <th scope="col" class="text-end">Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6">
                                <div class="empty-state text-center py-5 px-3">
                                    <i class="bi bi-ticket-perforated" aria-hidden="true"></i>
                                    <p class="text-muted mt-3 mb-3">No vouchers found. Create a voucher to record financial transactions.</p>
                                    <a asp-action="Entry" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create voucher</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
