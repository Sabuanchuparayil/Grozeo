@{
    ViewData["Title"] = "Operations Monitoring";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Operations Monitoring</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active">Monitoring</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-secondary btn-sm" disabled><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">API Health</div>
                            <div class="fs-5 fw-bold">—</div>
                        </div>
                        <div class="rounded-circle bg-secondary bg-opacity-10 p-2">
                            <i class="bi bi-hdd-network text-secondary fs-5"></i>
                        </div>
                    </div>
                    <span class="badge bg-secondary mt-2">Not monitored</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Database</div>
                            <div class="fs-5 fw-bold">—</div>
                        </div>
                        <div class="rounded-circle bg-secondary bg-opacity-10 p-2">
                            <i class="bi bi-database text-secondary fs-5"></i>
                        </div>
                    </div>
                    <span class="badge bg-secondary mt-2">Not monitored</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Redis Cache</div>
                            <div class="fs-5 fw-bold">—</div>
                        </div>
                        <div class="rounded-circle bg-secondary bg-opacity-10 p-2">
                            <i class="bi bi-lightning text-secondary fs-5"></i>
                        </div>
                    </div>
                    <span class="badge bg-secondary mt-2">Not monitored</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Queue</div>
                            <div class="fs-5 fw-bold">—</div>
                        </div>
                        <div class="rounded-circle bg-secondary bg-opacity-10 p-2">
                            <i class="bi bi-list-task text-secondary fs-5"></i>
                        </div>
                    </div>
                    <span class="badge bg-secondary mt-2">Not monitored</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-clock-history me-2"></i>Packing Delays
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-box display-4 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No packing delay alerts. All orders are being packed on time.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-truck me-2"></i>Delivery Delays
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-geo display-4 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No delivery delay alerts. All shipments are on schedule.</p>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-activity me-2"></i>Live Orders
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-broadcast display-4 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No live orders at the moment. Active orders will stream here in real time.</p>
                </div>
            </div>
        </div>
    </div>
</div>
