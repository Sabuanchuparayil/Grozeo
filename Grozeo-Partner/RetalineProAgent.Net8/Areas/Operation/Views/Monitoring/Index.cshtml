@{
    ViewData["Title"] = "Operations Monitoring";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Operations Monitoring</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="Tenant"})">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Monitoring</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="LiveOrders" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Refresh</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">API Health</div>
                            <div class="stat-tile-value fs-5">—</div>
                            <span class="badge bg-secondary mt-2">Not monitored</span>
                        </div>
                        <div class="stat-tile-icon stat-secondary" aria-hidden="true"><i class="bi bi-hdd-network"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Database</div>
                            <div class="stat-tile-value fs-5">—</div>
                            <span class="badge bg-secondary mt-2">Not monitored</span>
                        </div>
                        <div class="stat-tile-icon stat-secondary" aria-hidden="true"><i class="bi bi-database"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Redis Cache</div>
                            <div class="stat-tile-value fs-5">—</div>
                            <span class="badge bg-secondary mt-2">Not monitored</span>
                        </div>
                        <div class="stat-tile-icon stat-secondary" aria-hidden="true"><i class="bi bi-lightning-charge"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 stat-tile">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-tile-label">Queue</div>
                            <div class="stat-tile-value fs-5">—</div>
                            <span class="badge bg-secondary mt-2">Not monitored</span>
                        </div>
                        <div class="stat-tile-icon stat-secondary" aria-hidden="true"><i class="bi bi-list-task"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-clock-history me-2" aria-hidden="true"></i>Packing Delays
                </div>
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-box" aria-hidden="true"></i>
                        <p class="text-muted mt-3 mb-3">No packing delay alerts. When delays occur they will appear here.</p>
                        <a asp-action="PackingDelays" class="btn btn-outline-primary btn-sm">Open packing delays</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-truck me-2" aria-hidden="true"></i>Delivery Delays
                </div>
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <p class="text-muted mt-3 mb-3">No delivery delay alerts. Shipments on schedule will show live ETA updates here.</p>
                        <a asp-action="DeliveryDelays" class="btn btn-outline-primary btn-sm">Open delivery delays</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-activity me-2" aria-hidden="true"></i>Live Orders
                </div>
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-broadcast" aria-hidden="true"></i>
                        <p class="text-muted mt-3 mb-3">No live orders at the moment. Active orders will stream here in real time.</p>
                        <a asp-action="LiveOrders" class="btn btn-primary btn-sm"><i class="bi bi-receipt me-1" aria-hidden="true"></i>View live orders feed</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
