@{
    ViewData["Title"] = ViewBag.Title ?? "Error";
    Layout = null;
    var statusCode = ViewBag.StatusCode ?? 500;
    var message = ViewBag.Message ?? "An unexpected error occurred.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Grozeo Partner</title>
    <link rel="icon" type="image/png" href="~/images/grozeo-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        .error-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 3rem;
            width: 100%;
            max-width: 480px;
            text-align: center;
        }
        .error-icon {
            font-size: 4rem;
            line-height: 1;
            margin-bottom: 1rem;
        }
        .error-icon.e404 { color: #fd7e14; }
        .error-icon.e403 { color: #dc3545; }
        .error-icon.e500 { color: #6c757d; }
        .status-code {
            font-size: 5rem;
            font-weight: 800;
            line-height: 1;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
        }
        .brand-logo {
            height: 40px;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <img src="~/images/grozeo-logo.png" alt="Grozeo" class="brand-logo" />
        
        @{
            var iconClass = statusCode switch {
                404 => "bi-search e404",
                403 => "bi-shield-exclamation e403",
                _ => "bi-exclamation-triangle e500"
            };
        }
        <div class="error-icon @iconClass" role="img" aria-label="Error">
            <i class="bi @(statusCode == 404 ? "bi-search" : statusCode == 403 ? "bi-shield-exclamation" : "bi-exclamation-triangle")"></i>
        </div>
        
        <div class="status-code">@statusCode</div>
        <h2 class="h4 mb-2">@ViewData["Title"]</h2>
        <p class="text-muted mb-4">@message</p>
        
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house me-1" aria-hidden="true"></i>Go Home
            </a>
            <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Go Back
            </button>
        </div>
    </div>
</body>
</html>
